{
  "name": "tutor-learner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "server:build": "esbuild server/cli.ts --bundle --platform=node --format=esm --target=node22 --alias:@=./src --outfile=dist-server/server.mjs --log-level=warning",
    "stable:build": "node scripts/stable-build.mjs",
    "stable:start": "node scripts/stable-start.mjs",
    "stable:launchd": "node scripts/stable-launchd.mjs",
    "stable:update": "node scripts/stable-build.mjs && launchctl kickstart -k gui/$(id -u)/vn.khue.tutor-learner"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.59.0",
    "react": "^18.3.1",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "esbuild": "^0.21.5"
  }
}
